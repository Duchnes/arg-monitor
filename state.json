      "text_preview": "<!DOCTYPE html>\r\n<html lang=\"pl\">\r\n<head>\r\n <meta charset=\"utf-8\">\r\n <title>Quiz</title>\r\n <style>\r\n \r\n body {\r\n background-color: black;\r\n color: white;\r\n font-family: 'Times New Roman', Times, serif;\r\n display: flex;\r\n flex-direction: column; \r\n align-items: center;\r\n min-height: 100vh;\r\n margin: 0;\r\n padding-top: 50px;\r\n }\r\n \r\n h1 {\r\n font-size: 2.5rem;\r\n margin-bottom: 30px;\r\n }\r\n\r\n nav {\r\n margin-top: 40px;\r\n }\r\n\r\n nav a {\r\n color: white;\r\n text-decoration: none;\r\n font-size: 1.2rem;\r\n margin: 0 15px;\r\n border-bottom: 1px solid transparent;\r\n }\r\n\r\n nav a:hover {\r\n border-bottom: 1px solid white;\r\n }\r\n\r\n\r\n\r\n </style>\r\n</head>\r\n<body>\r\n \r\n <nav>\r\n <a href=\"index.html\">Strona Główna</a>\r\n </nav>\r\n\r\n <h1 style=\"margin-top: 30px; margin-bottom: 50px;\">Quiz</h1>\r\n\r\n <div id=\"quiz\"></div>\r\n <button id=\"submit\">Zatwierdź</button>\r\n <p id=\"message\"></p>\r\n\r\n <script>\r\n const questions = [\r\n { id: 1, text: \"O czym był fragment z Biblii?\" },\r\n { id: 2, text: \"Podaj po przecinku numery zdjęć które zostały zaszyfrowane steganografią?\" },\r\n { id: 3, text: \"Kim jest potwór według fragmentu z kartki we Wrocławiu?\" },\r\n ];\r\n\r\n const box = document.getElementById(\"quiz\");\r\n questions.forEach(q => {\r\n box.insertAdjacentHTML(\"beforeend\", `\r\n <p>${q.text}<br>\r\n <input type=\"text\" id=\"a${q.id}\">\r\n <span id=\"r${q.id}\"></span>\r\n </p>`);\r\n });\r\n\r\n document.getElementById(\"submit\").onclick = async () => {\r\n const answers = {};\r\n questions.forEach(q => answers[q.id] = document.getElementById(\"a\" + q.id).value);\r\n\r\ntry {\r\n const res = await fetch(\"check.php\", {\r\n method: \"POST\",\r\n headers: { \"Content-Type\": \"application/json\" },\r\n body: JSON.stringify(answers)\r\n });\r\n const data = await res.json();\r\n\r\n questions.forEach(q => {\r\n document.getElementById(\"r\" + q.id).textContent =\r\n data.results[q.id] ? \"☑\" : \"☒\";\r\n });\r\n\r\n document.getElementById(\"message\").textContent = data.message || \"\";\r\n} catch (e) {\r\n console.error(e);\r\n document.getElementById(\"message\").textContent = \"Błąd połączenia\";\r\n}\r\n };\r\n </script>\r\n</body>\r\n</html>"
