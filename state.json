      "text_preview": "<!DOCTYPE html>\r\n<html lang=\"pl\">\r\n<head>\r\n <meta charset=\"UTF-8\">\r\n <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\r\n <title>Dokumenty</title>\r\n <style>\r\n body {\r\n background-color: black;\r\n color: white;\r\n font-family: 'Times New Roman', Times, serif;\r\n display: flex;\r\n flex-direction: column;\r\n align-items: center;\r\n min-height: 100vh;\r\n margin: 0;\r\n padding-top: 50px;\r\n }\r\n\r\n h1 {\r\n font-size: 2.5rem;\r\n margin-bottom: 30px;\r\n }\r\n\r\n nav {\r\n margin-top: 40px;\r\n }\r\n\r\n nav a {\r\n color: white;\r\n text-decoration: none;\r\n font-size: 1.2rem;\r\n margin: 0 15px;\r\n border-bottom: 1px solid transparent;\r\n }\r\n\r\n nav a:hover {\r\n border-bottom: 1px solid white;\r\n }\r\n .login-form {\r\n display: flex;\r\n flex-direction: column; \r\n align-items: center; \r\n background: black;\r\n padding: 30px;\r\n border-radius: 8px;\r\n box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);\r\n }\r\n\r\n .login-form h2 {\r\n margin-bottom: 20px;\r\n }\r\n\r\n .login-form label {\r\n margin-bottom: 5px;\r\n align-self: flex-start; \r\n }\r\n\r\n .login-form input {\r\n width: 250px;\r\n padding: 10px;\r\n margin-bottom: 15px; \r\n border: 1px solid #ccc;\r\n border-radius: 4px;\r\n }\r\n .login-form button {\r\n width: 100%;\r\n padding: 10px;\r\n background-color: #323232;\r\n color: white;\r\n border: none;\r\n border-radius: 4px;\r\n cursor: pointer;\r\n font-size: 16px;\r\n }\r\n\r\n .login-form button:hover {\r\n background-color: #0056b3;\r\n }\r\n h1 {\r\n font-size: 2.5rem;\r\n margin-bottom: 30px;\r\n }\r\n </style>\r\n</head>\r\n<body>\r\n\r\n\r\n<nav>\r\n <a href=\"index.html\">Strona Główna</a>\r\n </nav>\r\n \r\n <h1>Zaloguj się</h1>\r\n \r\n <form class=\"login-form\" id=\"formularzLogowania\">\r\n <label for=\"login\">Login:</label>\r\n <input type=\"text\" id=\"login\" name=\"login\" required>\r\n \r\n <label for=\"haslo\">Hasło:</label>\r\n <input type=\"password\" id=\"haslo\" name=\"haslo\" required>\r\n \r\n <button type=\"submit\">Zaloguj się</button>\r\n </form>\r\n\r\n <script>\r\n document.getElementById('formularzLogowania').addEventListener('submit', function(event) {\r\n \r\n event.preventDefault();\r\n \r\n \r\n const wpisanyLogin = document.getElementById('login').value;\r\n const wpisaneHaslo = document.getElementById('haslo').value;\r\n \r\n \r\n if (wpisanyLogin === \"admin\") {\r\n \r\n window.location.href = wpisaneHaslo + \".html\";\r\n } else {\r\n \r\n window.location.href = \"404.html\";\r\n }\r\n });\r\n </script>"
