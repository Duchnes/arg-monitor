word\" id=\"haslo\" name=\"haslo\" required>\r\n \r\n <button type=\"submit\">Zaloguj się</button>\r\n </form>\r\n\r\n <script>\r\n document.getElementById('formularzLogowania').addEventListener('submit', function(event) {\r\n \r\n event.preventDefault();\r\n \r\n \r\n const wpisanyLogin = document.getElementById('login').value;\r\n const wpisaneHaslo = document.getElementById('haslo').value;\r\n \r\n \r\n if (wpisanyLogin === \"admin\") {\r\n \r\n window.location.href = wpisaneHaslo + \".html\";\r\n } else {\r\n \r\n window.location.href = \"404.html\";\r\n }\r\n });\r\n </script>"
